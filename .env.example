# EmailJS Configuration
# You can find these values in your EmailJS dashboard: https://dashboard.emailjs.com/

# Your Public Key (found in Account > API Keys)
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY

# Your Service ID (found in Email Services)
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID

# Your Template ID (found in Email Templates)
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
